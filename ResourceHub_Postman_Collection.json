    "description": "Comprehensive Postman test collection for ResourceHub – Library & Lab Equipment Booking/Management System.\n\nCovers Syllabus:\n- Point 53: HTTP Request/Response Lifecycle\n- Point 55: Express.js Routing\n- Point 56: RESTful Endpoints & Middleware\n- Point 57: JWT Authentication & Role-Based Access Control\n- Point 58: File Uploads & API Testing\n- Point 59: Firestore Database Operations\n- Point 60: Full-Stack Integration Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Local development URL or Production URL (https://library-management-system-xnax.onrender.com)"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "Bearer JWT token dynamically set by Login request test script"
    }
  ],
  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Health check verifying Express server and Firebase connection"
          }
        }
      ]
    },
    {
      "name": "1. Authentication & Users (Point 46, 57)",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('authToken', res.token);",
                  "    console.log('Saved authToken into collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@resourcehub.edu\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
