# ============================================
# RESOURCEHUB ENVIRONMENT CONFIGURATION
# Covers Syllabus:
# - Point 49: Node.js Environment Configuration
# - Point 54: npm and Environment Configuration
# - Point 60: Full-Stack Integration
# ============================================

# Express Server Port (Render sets process.env.PORT automatically)
PORT=5000
NODE_ENV=development

# JSON Web Token Secret (Mandatory in production; required for signing and verifying tokens)
JWT_SECRET=your_secure_random_jwt_secret_here

# Trusted CORS Origins (Comma-separated in production; e.g. https://your-frontend.com)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Firebase Admin SDK Credentials Path (Service Account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Email Notifications Configuration (Point 50 Asynchronous Workflows)
# Select: "gmail" for local development or "resend" for production
EMAIL_PROVIDER=gmail

# Gmail Configuration (When EMAIL_PROVIDER=gmail)
EMAIL_USER=your_email@university.edu
EMAIL_APP_PASSWORD=your_gmail_16_char_app_password

# Resend Configuration (When EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ResourceHub <onboarding@resend.dev>

# Web App Login Entry URL (Used in temporary credential invitation emails)
APP_LOGIN_URL=http://localhost:5000

# Optional Educational MongoDB & Mongoose Demo Module (Does not affect Firestore production database)
# Leave blank to keep MongoDB module disabled, or set to test Mongoose CRUD and schemas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resourcehub_demo?retryWrites=true&w=majority
