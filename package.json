{
  "name": "library-resource-management-system",
  "version": "1.0.0",
  "description": "Library & Lab Equipment Booking System with Role-Based Access",
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:nodemon": "nodemon server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "node server/data/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.5",
    "resend": "^6.22.1"
  },
  "engines": {
    "node": "20.x"
  }
}
